# Environment
ENVIRONMENT=development
DEBUG=true

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.7

# RoleColorFinder API
ROLECOLORFINDER_API_URL=https://api.rolecolorfinder.com
ROLECOLORFINDER_API_KEY=your_rolecolorfinder_api_key

# Security
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,txt
UPLOAD_DIR=uploads

# Storage Configuration
SUPABASE_BUCKET_NAME=resumes
SUPABASE_EXPORTS_BUCKET=exports

# Database (if using local PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/rolecolorai

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true

# Monitoring
SENTRY_DSN=your_sentry_dsn

# Feature Flags
ENABLE_BRANDING_TOGGLE=true
ENABLE_BATCH_PROCESSING=false
ENABLE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
