# Global Environment Variables
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# RoleColorFinder API (for fetching assessments)
ROLECOLORFINDER_API_URL=https://api.rolecolorfinder.com
ROLECOLORFINDER_API_KEY=your_rolecolorfinder_api_key

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,docx,txt

# Storage Configuration
SUPABASE_BUCKET_NAME=resumes
SUPABASE_EXPORTS_BUCKET=exports

# Security
JWT_SECRET=your_jwt_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (if using local PostgreSQL instead of Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/rolecolorai

# Redis (for caching, optional)
REDIS_URL=redis://localhost:6379

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Monitoring and Analytics
SENTRY_DSN=your_sentry_dsn
GOOGLE_ANALYTICS_ID=your_ga_id

# Feature Flags
ENABLE_BRANDING_TOGGLE=true
ENABLE_BATCH_PROCESSING=false
ENABLE_ANALYTICS=true
